# systemd unit for running the tab app on a Linux host.
# Install:  sudo cp deploy/musicvisualize.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now musicvisualize
# Adjust User and WorkingDirectory to match where you cloned it.
[Unit]
Description=TabMonkey - band tab app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/musicvisualize
ExecStart=/usr/bin/env node server.js
Environment=NODE_ENV=production
Environment=PORT=3000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
